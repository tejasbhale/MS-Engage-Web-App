# Copy this file to `client/.env` and fill in real values. `client/.env` is gitignored.

# Same Google OAuth client ID as the server's GOOGLE_CLIENT_ID.
REACT_APP_GOOGLE_CLIENT_ID=

# Base URL of the Express auth server.
REACT_APP_API_URL=http://localhost:5001

# Live transcription engine: "assemblyai" (needs ASSEMBLYAI_API_KEY on the
# server) or "webspeech" (free, browser-native). assemblyai auto-falls-back
# to webspeech if the server has no key.
REACT_APP_TRANSCRIPTION_MODE=assemblyai
