# Copy this file to `.env` and fill in real values. `.env` is gitignored.

# Google OAuth 2.0 — create a Web application client at
# https://console.cloud.google.com/apis/credentials and paste its client ID here.
# Add http://localhost:3000 to "Authorized JavaScript origins".
GOOGLE_CLIENT_ID=

# Secret used to sign session JWTs. Generate one with: openssl rand -hex 32
JWT_SECRET=

# Comma-separated origins allowed to send credentialed requests.
CLIENT_ORIGIN=http://localhost:3000

# macOS AirPlay Receiver (Control Center) occupies port 5000, so use 5001.
PORT=5001

# AssemblyAI realtime transcription (https://www.assemblyai.com/dashboard).
# Leave empty to use the browser's free Web Speech fallback on the client.
ASSEMBLYAI_API_KEY=

# Google AI Studio key for Gemini summaries (https://aistudio.google.com/apikey).
# Leave empty to use a keyless heuristic fallback summarizer.
GOOGLE_API_KEY=
# Optional override; defaults to gemini-2.5-flash.
GEMINI_MODEL=

# MongoDB connection string (e.g. your MongoDB Atlas M0 connection string).
# Leave empty to run signaling-only with no persistence.
MONGODB_URI=
